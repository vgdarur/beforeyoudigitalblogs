// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER")
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("dl_User")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dl_Session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("dl_VerificationToken")
}

model Network {
  id        String   @id @default(cuid())
  name      String   @unique // e.g., "CJ", "Amazon Associates", "Rakuten"
  slug      String   @unique
  apiKey    String?  // Optional raw API credential
  trackingId String? // e.g. Amazon Store ID or custom SubID tag
  deals     Deal[]
  clicks    Click[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dl_Network")
}

model Merchant {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  logoUrl      String?
  affiliateUrl String?
  deals        Deal[]
  clicks       Click[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("dl_Merchant")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  deals     Deal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dl_Category")
}

model Deal {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  description   String
  imageUrl      String?
  price         Float?
  originalPrice Float?
  discountRatio Float?    // e.g., 0.20 for 20% off
  couponCode    String?
  affiliateUrl  String
  expirationDate DateTime?
  isActive      Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  priorityScore Int       @default(0)
  
  merchantId    String
  merchant      Merchant  @relation(fields: [merchantId], references: [id])
  
  networkId     String?
  network       Network?  @relation(fields: [networkId], references: [id])
  
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id])
  
  clicks        Click[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("dl_Deal")
}

model Click {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  referrer   String?
  device     String?
  
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id])
  
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  
  networkId  String?
  network    Network? @relation(fields: [networkId], references: [id])

  @@map("dl_Click")
}

model FeedSource {
  id        String   @id @default(cuid())
  name      String
  url       String
  format    String   @default("CSV") // CSV, JSON, XML
  isActive  Boolean  @default(true)
  jobs      FeedImportJob[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dl_FeedSource")
}

model FeedImportJob {
  id           String     @id @default(cuid())
  status       String     // PENDING, PROCESSING, COMPLETED, FAILED
  itemsFound   Int        @default(0)
  itemsImported Int       @default(0)
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  
  feedSourceId String
  feedSource   FeedSource @relation(fields: [feedSourceId], references: [id])

  @@map("dl_FeedImportJob")
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("dl_Subscriber")
}

model ZipcodeLog {
  id        String   @id @default(cuid())
  zipcode   String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("dl_ZipcodeLog")
}
